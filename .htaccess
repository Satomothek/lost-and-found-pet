<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Prevent access to restricted directories
    RewriteRule ^config/ - [F]
    RewriteRule ^lib/ - [F]
    RewriteRule ^database/ - [F]
    
    # Default page — hanya redirect jika file/direktori tidak ada,
    # dan bukan request ke folder asset atau PHP folder
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^.*/api/
    RewriteCond %{REQUEST_URI} !^.*/pages/
    RewriteCond %{REQUEST_URI} !^.*/css/
    RewriteCond %{REQUEST_URI} !^.*/js/
    RewriteCond %{REQUEST_URI} !^.*/public/
    RewriteCond %{REQUEST_URI} !^.*/images/
    RewriteRule ^(.*)$ pages/login.php [QSA,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
Options -Indexes

# Compress output
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
